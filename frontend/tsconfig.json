{
  "compilerOptions": {
    "target": "ES2022",                          /* Modern JS engine target */
    "module": "NodeNext",                        /* Handles modern ES imports cleanly */
    "moduleResolution": "NodeNext",
    "rootDir": "./src",                          /* Source code location */
    "outDir": "./dist",                          /* Compiled javascript output (Like /bin/) */
    "esModuleInterop": true,                     /* Emits additional JavaScript to ease support for importing CommonJS modules */
    "forceConsistentCasingInFileNames": true,    /* Ensures Windows vs Mac file systems behave */
    "strict": true,                              /* Enable all strict type-checking options */
    "skipLibCheck": true                         /* Skip type checking of declaration files */
  },
  "include": ["src/**/*"]
}